{
  "title": "Butterfly launches Codex in iTerm",
  "rules": [
    {
      "description": "F18 -> new iTerm tab running codex",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "f18" },
          "to": [
            { "shell_command": "$HOME/.config/karabiner/scripts/codex-tab.sh" }
          ]
        }
      ]
    }
  ]
}
